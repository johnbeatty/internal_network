<% content_for(:menu_header_link) { "radius_users" } %>
<% content_for(:header_title) { "Radius Users" } %>
<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900">Edit User</h1>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "All Users", radius_users_path, class: "block rounded-md border border-indigo-600 px-3 py-2 text-center text-sm font-semibold text-indigo-600 shadow-xs hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-100" %>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="mx-auto max-w-xl">
      <%= render 'form' %>
    </div>
  </div>
</div>